{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "hoo-browser",
  "version": "0.1.8",
  "description": "Browser automation for hoocode: one shared Chromium driven via the agent-browser CLI, one tab lease per agent over a tier C helper.",
  "license": "MIT",
  "repository": "https://github.com/kolisachint/hoo-browser-plugin",
  "keywords": [
    "browser",
    "automation",
    "chromium",
    "agent-browser"
  ],
  "extensions": {
    "dev.hoocode": {
      "native": {
        "server": "hoo-browser",
        "shared": true,
        "binaries": {
          "linux-x86_64": {
            "url": "https://github.com/kolisachint/hoo-browser-plugin/releases/download/v0.1.8/hoo-browser-linux-x86_64",
            "sha256": "e77be6e0efc9f2bb67af46540ce2796943b19a7b86173083be7654bcd6505f97"
          },
          "linux-aarch64": {
            "url": "https://github.com/kolisachint/hoo-browser-plugin/releases/download/v0.1.8/hoo-browser-linux-aarch64",
            "sha256": "c9445ad6bfd6758728ba795368e249f1bd56141d1ae99371541075334d506561"
          },
          "darwin-aarch64": {
            "url": "https://github.com/kolisachint/hoo-browser-plugin/releases/download/v0.1.8/hoo-browser-darwin-aarch64",
            "sha256": "92d3c49d5e43bddffc8122ff853263af0d22c69b3661af8d33191d32479222fc"
          },
          "darwin-x86_64": {
            "url": "https://github.com/kolisachint/hoo-browser-plugin/releases/download/v0.1.8/hoo-browser-darwin-x86_64",
            "sha256": "27a3ab4e48b091bc4babe7699ccf86a4ccd049ce957e26ed0973cb3a38efd8d8"
          }
        },
        "tools": [
          {
            "name": "browser_open",
            "description": "Open a URL in the caller's tab (agent-browser `open`); any free slot 1-4 opens directly.",
            "inputSchema": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string"
                },
                "tab": {
                  "type": "integer",
                  "description": "Tab number 1-4 (default 1); browser_open opens that slot when free, other tools need it open."
                }
              },
              "required": [
                "url"
              ]
            },
            "permission": "read"
          },
          {
            "name": "browser_snapshot",
            "description": "Accessibility snapshot of the caller's tab: refs for `browser_act`, text for reading.",
            "inputSchema": {
              "type": "object",
              "properties": {
                "tab": {
                  "type": "integer",
                  "description": "Tab number 1-4 (default 1); browser_open opens that slot when free, other tools need it open."
                },
                "interactive": {
                  "type": "boolean",
                  "description": "Cursor position and interactive-only refs."
                }
              },
              "required": []
            },
            "permission": "read"
          },
          {
            "name": "browser_act",
            "description": "Act on a ref from the snapshot: click, fill, select, check, uncheck, hover, press.",
            "inputSchema": {
              "type": "object",
              "properties": {
                "action": {
                  "type": "string",
                  "enum": [
                    "click",
                    "fill",
                    "select",
                    "check",
                    "uncheck",
                    "hover",
                    "press"
                  ]
                },
                "ref": {
                  "type": "string",
                  "description": "Ref from the snapshot (e.g. \"e3\")."
                },
                "value": {
                  "type": "string",
                  "description": "Text for fill, option for select, key for press."
                },
                "tab": {
                  "type": "integer",
                  "description": "Tab number 1-4 (default 1); browser_open opens that slot when free, other tools need it open."
                }
              },
              "required": [
                "action",
                "ref"
              ]
            },
            "permission": "act"
          },
          {
            "name": "browser_screenshot",
            "description": "Screenshot of the caller's tab, returned as an image.",
            "inputSchema": {
              "type": "object",
              "properties": {
                "tab": {
                  "type": "integer",
                  "description": "Tab number 1-4 (default 1); browser_open opens that slot when free, other tools need it open."
                },
                "full_page": {
                  "type": "boolean",
                  "description": "Capture the full page, not just the viewport."
                }
              },
              "required": []
            },
            "permission": "read"
          },
          {
            "name": "browser_tabs",
            "description": "List this agent's tabs, close one, or (root only) adopt another agent's tabs.",
            "inputSchema": {
              "type": "object",
              "properties": {
                "action": {
                  "type": "string",
                  "enum": [
                    "list",
                    "close",
                    "adopt"
                  ]
                },
                "tab": {
                  "type": "integer",
                  "description": "Tab number 1-4 (default 1); browser_open opens that slot when free, other tools need it open."
                },
                "from": {
                  "type": "string",
                  "description": "Agent id to adopt tabs from (adopt only, root only)."
                }
              },
              "required": [
                "action"
              ]
            },
            "permission": "act"
          },
          {
            "name": "browser_wait",
            "description": "Wait in the caller's tab: milliseconds, text, ref, or load state.",
            "inputSchema": {
              "type": "object",
              "properties": {
                "tab": {
                  "type": "integer",
                  "description": "Tab number 1-4 (default 1); browser_open opens that slot when free, other tools need it open."
                },
                "ms": {
                  "type": "integer",
                  "description": "Milliseconds to wait."
                },
                "text": {
                  "type": "string",
                  "description": "Text to wait for."
                },
                "ref": {
                  "type": "string",
                  "description": "Ref to wait for (from the snapshot)."
                },
                "load": {
                  "type": "string",
                  "description": "Load state to wait for (e.g. networkidle)."
                }
              },
              "required": []
            },
            "permission": "read"
          },
          {
            "name": "browser_nav",
            "description": "Navigate the caller's tab: back, forward, reload.",
            "inputSchema": {
              "type": "object",
              "properties": {
                "action": {
                  "type": "string",
                  "enum": [
                    "back",
                    "forward",
                    "reload"
                  ]
                },
                "tab": {
                  "type": "integer",
                  "description": "Tab number 1-4 (default 1); browser_open opens that slot when free, other tools need it open."
                }
              },
              "required": [
                "action"
              ]
            },
            "permission": "act"
          },
          {
            "name": "browser_eval",
            "description": "Run JavaScript in the caller's tab and return the result.",
            "inputSchema": {
              "type": "object",
              "properties": {
                "js": {
                  "type": "string"
                },
                "tab": {
                  "type": "integer",
                  "description": "Tab number 1-4 (default 1); browser_open opens that slot when free, other tools need it open."
                }
              },
              "required": [
                "js"
              ]
            },
            "permission": "dangerous"
          }
        ]
      }
    }
  }
}
